# -----------------------------------------------------------------------------
# Local environment configuration
#
# Copy this file to `.env.local` and replace the placeholder values.
# Never commit `.env.local` or any file that contains real secrets.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by the application and Prisma CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fyp_project?schema=public"

# Secret used to sign session cookies. Generate a unique value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-value"
